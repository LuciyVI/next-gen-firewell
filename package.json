{
  "name": "usergate-packet-control",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && npm run check:release",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test src/*.test.ts",
    "test:e2e": "node --import tsx tests/e2e.mjs",
    "build:standalone": "npm run build && node scripts/export-standalone.mjs && npm run check:release",
    "test:standalone": "node --import tsx tests/standalone.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test:release": "node scripts/test-release.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "javascript-obfuscator": "5.9.0",
    "playwright": "^1.51.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
